# Public site. Change this if you choose another JUNKBRANDING subdomain.
NEXT_PUBLIC_SITE_URL=https://decisions.junkbranding.com

# AI pipeline. Set a model that is available in your OpenAI API account.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_ENABLE_WEB_SEARCH=true
OPENAI_WEB_SEARCH_TOOL=web_search

# Safety defaults. Keep false until branch protection and reviews are configured.
AI_ALLOW_PUBLISH=false
AI_ALLOW_EXISTING_DECISION_UPDATE=false
AI_REQUIRE_PRIMARY_SOURCES=true

# Optional GitHub metadata used in generated PR text.
GITHUB_REPOSITORY=
